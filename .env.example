# ============================================================
# Application
# ============================================================

APP_ENV=development
APP_NAME=Hybrid AI-NWP Forecast System
LOG_LEVEL=INFO

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hybrid_forecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/hybrid_forecast

# ============================================================
# Data storage
# ============================================================

DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CACHE_DIR=./data/cache
MODEL_DIR=./models

# ============================================================
# Open-Meteo
# ============================================================

OPEN_METEO_HISTORICAL_FORECAST_URL=https://historical-forecast-api.open-meteo.com/v1/forecast
OPEN_METEO_ERA5_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_GFS_URL=https://api.open-meteo.com/v1/gfs
OPEN_METEO_ECMWF_URL=https://api.open-meteo.com/v1/ecmwf
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble

# ============================================================
# Data collection
# ============================================================

REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=5
REQUEST_DELAY_SECONDS=0.25